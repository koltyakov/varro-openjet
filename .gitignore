# --- Build output ------------------------------------------------------------
build/
out/
dist/
.gradle/
.kotlin/ 

# Local platform artifacts resolved by the IntelliJ Platform Gradle plugin.
.intellijPlatform/

# Generated by `npm run build` in webview/ (see build.gradle.kts: buildWebview).
# Committing it would mean every webview change showed up twice in review.
/src/main/resources/webview/

# --- Dependencies ------------------------------------------------------------
node_modules/

# A clone the vendoring script manages; webview/vendor IS committed.
/webview/.upstream/

# --- Local configuration -----------------------------------------------------
local.properties
.env
.env.local

# --- IDE ---------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/

# --- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Java / JVM --------------------------------------------------------------
*.class
*.log
*.ctxt
.mtj.tmp/
hs_err_pid*
replay_pid*

# Archives are build artifacts, except the Gradle wrapper, which has to be
# committed for `./gradlew` to work on a fresh clone.
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
!gradle/wrapper/gradle-wrapper.jar

