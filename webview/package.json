{
  "name": "varro-openjet-webview",
  "private": true,
  "type": "module",
  "description": "Build workspace for the Varro webview running inside JetBrains JCEF.",
  "repository": "https://github.com/koltyakov/varro-openjet",
  "scripts": {
    "sync": "node scripts/sync-upstream.mjs",
    "sync:check": "node scripts/vendor-integrity.mjs",
    "build": "vite build",
    "benchmark": "node scripts/scroll-benchmark.mjs",
    "test:host": "vitest run --config vitest.host.config.mts",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "comments": {
    "versions": "Dependency versions are pinned to the upstream Varro revision recorded in upstream.json so the vendored sources build against the libraries they were written for.",
    "toolchain": "node/npm are pinned with Volta and matched exactly by the Dockerfile. npm writes package-lock.json differently across versions, so an unpinned toolchain makes the lockfile churn on every build."
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "jsonc-parser": "3.3.1",
    "katex": "0.19.1",
    "marked": "18.1.2",
    "mermaid": "^12.2.0",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@opencode/client": "^2.2.3",
    "@types/node": "26.6.6",
    "@tailwindcss/vite": "4.3.3",
    "iconoir": "7.12.1",
    "material-icon-theme": "5.40.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.15",
    "vitest": "5.0.5"
  },
  "overrides": {
    "mermaid": {
      "katex": "0.19.1"
    },
    "seroval": "1.6.8"
  },
  "volta": {
    "node": "24.22.2",
    "npm": "12.2.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0",
    "npm": ">=12.2.1 <13"
  }
}
